generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COORDINADOR
  ENTRENADOR
  PREPARADOR_FISICO
}

enum TrainerType {
  ENTRENADOR
  PREPARADOR_FISICO
}

enum AttendanceStatus {
  PRESENTE
  AUSENTE
  JUSTIFICADA
  TARDE
}

enum SiteSectionKey {
  COORDINACION
  RECURSOS
}

model User {
  id                 Int          @id @default(autoincrement())
  email              String       @unique
  passwordHash       String
  role               Role
  trainerId          Int?         @unique
  trainer            Trainer?     @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  attendancesCreated Attendance[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("users")
}

model Trainer {
  id             Int                     @id @default(autoincrement())
  name           String
  slug           String                  @unique
  type           TrainerType             @default(ENTRENADOR)
  bio            String?
  specialty      String?
  photoUrl       String?
  cvUrl          String?
  user           User?
  sectionAccess  SectionAccess[]
  divisionAccess TrainerDivisionAccess[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@map("trainers")
}

model Section {
  id            Int             @id @default(autoincrement())
  title         String
  content       String
  sectionAccess SectionAccess[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("sections")
}

model SectionAccess {
  id        Int      @id @default(autoincrement())
  sectionId Int
  trainerId Int
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  trainer   Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([sectionId, trainerId])
  @@map("section_access")
}

model Division {
  id               Int                     @id @default(autoincrement())
  name             String
  seasonYear       Int
  players          Player[]
  trainingSessions TrainingSession[]
  trainerAccess    TrainerDivisionAccess[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([name, seasonYear])
  @@map("divisions")
}

model Player {
  id         Int          @id @default(autoincrement())
  fullName   String
  birthYear  Int
  phone      String?
  email      String?
  parentName String?
  parentEmail String?
  parentPhone String?
  active     Boolean      @default(true)
  divisionId Int
  division   Division     @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  attendance Attendance[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([divisionId])
  @@map("players")
}

model TrainingSession {
  id         Int          @id @default(autoincrement())
  divisionId Int
  division   Division     @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  date       DateTime
  month      Int
  notes      String?
  attendance Attendance[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([divisionId, date])
  @@index([divisionId, month])
  @@map("training_sessions")
}

model Attendance {
  id                Int              @id @default(autoincrement())
  playerId          Int
  trainingSessionId Int
  status            AttendanceStatus
  observation       String?
  createdByUserId   Int
  player            Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  trainingSession   TrainingSession  @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  createdByUser     User             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([playerId, trainingSessionId])
  @@index([trainingSessionId])
  @@index([playerId])
  @@map("attendance")
}

model TrainerDivisionAccess {
  id         Int      @id @default(autoincrement())
  trainerId  Int
  divisionId Int
  trainer    Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([trainerId, divisionId])
  @@map("trainer_division_access")
}

model VirtualLibrarySection {
  id         Int                      @id @default(autoincrement())
  name       String
  slug       String                   @unique
  sortOrder  Int                      @default(0)
  categories VirtualLibraryCategory[]
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  @@map("virtual_library_sections")
}

model VirtualLibraryCategory {
  id         Int                 @id @default(autoincrement())
  sectionId  Int
  name       String
  slug       String
  sortOrder  Int                 @default(0)
  section    VirtualLibrarySection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  videos     VirtualLibraryVideo[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([sectionId, slug])
  @@map("virtual_library_categories")
}

model VirtualLibraryVideo {
  id         Int                    @id @default(autoincrement())
  categoryId Int
  title      String
  url        String
  sortOrder  Int                    @default(0)
  category   VirtualLibraryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@map("virtual_library_videos")
}

model SiteSubdivision {
  id         Int             @id @default(autoincrement())
  sectionKey SiteSectionKey
  name       String
  slug       String
  description String?
  sortOrder  Int             @default(0)
  pages      SitePage[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([sectionKey, slug])
  @@map("site_subdivisions")
}

model SitePage {
  id            Int            @id @default(autoincrement())
  subdivisionId Int
  title         String
  slug          String
  summary       String?
  content       String?
  sortOrder     Int            @default(0)
  subpages      SiteSubpage[]
  subdivision   SiteSubdivision @relation(fields: [subdivisionId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([subdivisionId, slug])
  @@map("site_pages")
}

model SiteSubpage {
  id        Int      @id @default(autoincrement())
  pageId    Int
  title     String
  slug      String
  summary   String?
  content   String?
  sortOrder Int      @default(0)
  page      SitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageId, slug])
  @@map("site_subpages")
}
